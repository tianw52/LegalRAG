# LegalRAG settings. Only the LLM server needs choosing: everything else
# (OpenSearch on localhost:9200, index canlegal-qwen3, Qwen3 embedding + reranker, …)
# has a working default in legalrag/core/config.py. Add VAR=value here only to
# override one of those defaults (names are the aliases in config.py).
#
# Pick ONE LLM block (comment the others out). Each block sets LLM_THINKING_OFF,
# which must match the server (see legalrag/core/config.py).

# vLLM (default; serves the parallel view/chat calls concurrently). Either:
#   this Mac:  bash scripts/serve_qwen3_vllm_metal.sh          (vllm-metal, Qwen3-8B MLX)
#   lab 4090:  bash scripts/serve_qwen3_vllm.sh on the lab, then on the laptop
#              ssh -N -L 8001:127.0.0.1:8001 secb1010-d11.csil.sfu.ca   (SFU network / VPN)
LLM_BASE_URL=http://localhost:8001/v1
LLM_API_KEY=EMPTY
LLM_MODEL=qwen3
LLM_THINKING_OFF=vllm

# Local Ollama (laptop; slow — LLM calls queue one after another)
#   ollama pull qwen3:8b && OLLAMA_CONTEXT_LENGTH=16384 ollama serve
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen3:8b
# LLM_THINKING_OFF=ollama

# HuggingFace Inference Router (paid credits)
# LLM_BASE_URL=https://router.huggingface.co/v1
# LLM_API_KEY=hf_...   # https://huggingface.co/settings/tokens
# LLM_MODEL=Qwen/Qwen3.5-397B-A17B:novita
# LLM_THINKING_OFF=none
