# LegalRAG settings. Only the LLM server needs choosing: everything else
# (OpenSearch on localhost:9200, index canlegal-qwen3, Qwen3 embedding + reranker, …)
# has a working default in legalrag/core/config.py. Add VAR=value here only to
# override one of those defaults (names are the aliases in config.py).
#
# Pick ONE LLM block. After switching, set legalrag/prompts/explore_policy.yaml →
# llm.thinking_off to the value shown next to the block.

# Local Ollama (default)                                           thinking_off: ollama
#   ollama pull qwen3:8b && OLLAMA_CONTEXT_LENGTH=16384 ollama serve
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:8b

# Lab vLLM (scripts/serve_qwen3_vllm.sh + ssh -N -L 8001:127.0.0.1:8001 secb1010-d11.csil.sfu.ca)
#                                                                  thinking_off: vllm
# LLM_BASE_URL=http://localhost:8001/v1
# LLM_API_KEY=EMPTY
# LLM_MODEL=qwen3

# HuggingFace Inference Router (paid credits)                     thinking_off: none
# LLM_BASE_URL=https://router.huggingface.co/v1
# LLM_API_KEY=hf_...   # https://huggingface.co/settings/tokens
# LLM_MODEL=Qwen/Qwen3.5-397B-A17B:novita
