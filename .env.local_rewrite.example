# =============================================================================
# Local Qwen rewrite — بدون API (نه HF Router، نه Together)
# =============================================================================
# فایل واقعی:  .env.local_rewrite  (کپی کن و در صورت نیاز مسیر مدل را بده)
#   cp .env.local_rewrite.example .env.local_rewrite
#
# اسکریپت: scripts/rewrite_benchmark_50_qwen35_9b_local.py
# نصب وابستگی (بدون legalrag):  pip install -r requirements-local-rewrite.txt
# مسیر جایگزین:  export LOCAL_REWRITE_ENV_FILE=/path/to/.env.local_rewrite
#
# برای دانلود اولیهٔ وزن از Hub (مدل عمومی)، توکن لازم نیست.
# اگر مدل gated بود، همان HF_TOKEN معمول را در محیط بگذار (نه در این فایل اگر commit می‌کنی).
# =============================================================================

# مسیر لوکال یا شناسهٔ Hub (پیش‌فرض: Qwen/Qwen3.5-9B)
LOCAL_MODEL_ID=Qwen/Qwen3.5-9B

# auto | cuda | cpu
LOCAL_REWRITE_DEVICE=auto

# bfloat16 | float16 | float32  (روی CPU اگر bf16 خطا داد، float32 امتحان کن)
LOCAL_REWRITE_DTYPE=bfloat16

LOCAL_REWRITE_MAX_NEW_TOKENS=768
LOCAL_REWRITE_TEMPERATURE=0.35
LOCAL_REWRITE_TOP_P=0.9

# پس از هر ردیف (ثانیه؛ برای خنک‌کردن GPU معمولاً 0 کافی است)
# LOCAL_REWRITE_SLEEP=0
