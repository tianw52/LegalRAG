# =============================================================================
# Hugging Face ONLY — جدا از .env (جمنای / LLM اصلی را دست نزن)
# =============================================================================
# فایل اصلی:  .env.hf_rewrite  (همین را کپی کن و توکن را داخلش بگذار)
#   cp .env.hf_rewrite.example .env.hf_rewrite
# سپس فقط خط HF_TOKEN= را پر کن. این فایل در .gitignore است.
#
# اسکریپت: scripts/rewrite_benchmark_50_qwen35_9b_hf.py
# مسیر دیگر:  export HF_REWRITE_ENV_FILE=/path/to/your_hf.env
# =============================================================================

HF_TOKEN=

# Optional alias:
# LLM_API_KEY=

LLM_BASE_URL=https://router.huggingface.co/v1
LLM_MODEL=Qwen/Qwen3.5-9B

# Optional: seconds to sleep after each successful rewrite (default 0.75)
# HF_REWRITE_SLEEP=0.75
